# App/server
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/playlist_generate?sslmode=disable"
# Local Prisma migration development only. Use a separate disposable database.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/playlist_generate_shadow?sslmode=disable"
BETTER_AUTH_URL="http://127.0.0.1:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret"

# Providers/server
SETLISTFM_API_KEY="your-setlistfm-api-key"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
# Apple Music: base64-encode the complete contents of the Media Services .p8 key.
APPLE_MUSIC_TEAM_ID="your-10-character-apple-team-id"
APPLE_MUSIC_KEY_ID="your-10-character-media-services-key-id"
APPLE_MUSIC_PRIVATE_KEY_BASE64="base64-encoded-media-services-private-key"
# Generate with: openssl rand -base64 32
APPLE_MUSIC_TOKEN_ENCRYPTION_KEY="base64-encoded-32-byte-encryption-key"
# Comma-separated deployed browser origins. Leave empty locally.
# Example Vercel value: https://dev.playencore.app,https://playencore.app
APPLE_MUSIC_ALLOWED_ORIGINS=""
# Comma-separated Encore user IDs allowed to link and export to Spotify.
# Leave empty to disable Spotify for every user.
SPOTIFY_BETA_USER_IDS="your-encore-user-id"
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="Encore <auth@playencore.app>"

# Configure this redirect URL in the Spotify developer dashboard:
# http://127.0.0.1:3000/api/auth/callback/spotify

# Configure this redirect URL in the Google Cloud console:
# http://127.0.0.1:3000/api/auth/callback/google
